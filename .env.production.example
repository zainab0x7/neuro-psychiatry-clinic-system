# ==============================================================================
# Production Environment Configuration - Personal Clinic EMR
# Copy this file to .env.production on the production VPS
# CAUTION: NEVER commit .env.production or real secrets to source control!
# ==============================================================================

# 1. Server Environment
NODE_ENV=production
PORT=5000

# 2. Production MongoDB Connection String (Self-Hosted on Localhost)
MONGODB_URI=mongodb://emr_app_user:<GENERATE_A_STRONG_UNIQUE_PASSWORD>@127.0.0.1:27017/psychiatrist_emr?authSource=psychiatrist_emr

# 3. Security Secrets (MUST be unique, 32+ characters long)
# Generate via: openssl rand -hex 32
JWT_SECRET=<GENERATE_A_STRONG_UNIQUE_32_PLUS_CHAR_SECRET>
SESSION_SECRET=<GENERATE_A_STRONG_UNIQUE_32_PLUS_CHAR_SECRET>

# 4. Frontend Public API URL (Used by Next.js client side)
NEXT_PUBLIC_API_URL=https://emr.yourclinicdomain.com

# 5. Production CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=https://emr.yourclinicdomain.com

# 6. Initial Production Admin Account Bootstrap (Used ONLY on first launch when database has 0 users)
INITIAL_ADMIN_EMAIL=admin@yourclinicdomain.com
INITIAL_ADMIN_PASSWORD=<GENERATE_A_STRONG_UNIQUE_PASSWORD>
 
# 7. Supabase PostgreSQL & Auth Configuration
SUPABASE_URL=https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<YOUR_SUPABASE_PUBLISHABLE_KEY>
SUPABASE_SECRET_KEY=sb_secret_<YOUR_SUPABASE_SECRET_KEY>
SUPABASE_JWKS_URL=https://<YOUR_SUPABASE_PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json
