# Environment Configuration Template for Psychiatry EMR System
# Do NOT put real secrets in this file. Copy to .env.local for local development.

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/psychiatrist_emr

# JWT and Session Security (Use a strong 32+ character secret in production)
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters_here
SESSION_SECRET=your_secure_session_secret_key_minimum_32_characters_here

# Backend Express Server Port
PORT=5000

# Application Environment (development, test, or production)
NODE_ENV=development

# Frontend API URL Configuration (Used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Allowed Frontend Origins for Production CORS (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Initial Production Admin Account Bootstrap Credentials (Used only on first startup if database is empty)
INITIAL_ADMIN_EMAIL=admin@yourclinicdomain.com
INITIAL_ADMIN_PASSWORD=your_strong_production_admin_password_here

# Supabase PostgreSQL & Auth Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

